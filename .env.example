# Customer Tracker - PDF report settings
#
# Copy this file to .env and edit the values, then rebuild with
# build-installer.bat (or npm run build). electron-vite bakes these values
# into the app at build time, so changes need a rebuild to show up.

# Business name printed in the PDF letterhead and on every page footer
MAIN_VITE_REPORT_COMPANY_NAME=Customer Tracker

# Optional address and contact line under the business name (blank hides it)
MAIN_VITE_REPORT_COMPANY_ADDRESS=
MAIN_VITE_REPORT_COMPANY_CONTACT=

# Closing note printed at the end of every PDF report
MAIN_VITE_REPORT_FOOTER_NOTE=Confidential — prepared for internal records

# How many top buyers and top transactions the yearly report lists (3 to 50)
MAIN_VITE_REPORT_TOP_LIMIT=10
